[Unit]
Description=Scheduler API - FastAPI/Uvicorn
After=redis.service

[Service]
Type=simple
User=DEPLOY_USER
Group=DEPLOY_GROUP

WorkingDirectory=DEPLOY_PATH
EnvironmentFile=DEPLOY_PATH/.env
ExecStart=DEPLOY_PATH/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8014
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
